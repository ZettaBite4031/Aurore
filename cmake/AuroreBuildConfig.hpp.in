#pragma once

/*
    Generated by CMake. Do not edit the generated copy.

    Compiler/OS built-ins are interpreted once by CMake. Aurore-owned source
    should use this contract when it needs to reason about supported platforms
    or compiled network backends.
*/

#cmakedefine01 AURORE_PLATFORM_WINDOWS
#cmakedefine01 AURORE_PLATFORM_LINUX
#cmakedefine01 AURORE_PLATFORM_MACOS

#cmakedefine01 AURORE_NETWORK_BACKEND_IOCP
#cmakedefine01 AURORE_NETWORK_BACKEND_EPOLL
#cmakedefine01 AURORE_NETWORK_BACKEND_KQUEUE

#cmakedefine01 AURORE_ALLOW_MISSING_PLATFORM_BACKEND

#define AURORE_PLATFORM_COUNT \
	(AURORE_PLATFORM_WINDOWS \
	+ AURORE_PLATFORM_LINUX \
	+ AURORE_PLATFORM_MACOS)

#define AURORE_NETWORK_BACKEND_COUNT \
	(AURORE_NETWORK_BACKEND_IOCP \
	+ AURORE_NETWORK_BACKEND_EPOLL \
	+ AURORE_NETWORK_BACKEND_KQUEUE)

#define AURORE_HAS_PLATFORM_NETWORK_BACKEND \
	(AURORE_NETWORK_BACKEND_COUNT > 0)

#if AURORE_PLATFORM_COUNT != 1
#error "Aurore requires exactly one configured target platform."
#endif

#if AURORE_NETWORK_BACKEND_COUNT > 1
#error "Aurore may compile exactly one native network backend."
#endif

#if AURORE_PLATFORM_WINDOWS && !defined(_WIN32)
#error "CMake selected Windows but the compiler does not define _WIN32."
#endif

#if AURORE_PLATFORM_LINUX && !defined(__linux__)
#error "CMake selected Linux but the compiler does not define __linux__."
#endif

#if AURORE_PLATFORM_MACOS && !defined(__APPLE__)
#error "CMake selected macOS but the compiler does not define __APPLE__."
#endif

#if AURORE_NETWORK_BACKEND_IOCP && !AURORE_PLATFORM_WINDOWS
#error "The IOCP backend may only be compiled for Windows."
#endif

#if AURORE_NETWORK_BACKEND_EPOLL && !AURORE_PLATFORM_LINUX
#error "The epoll backend may only be compiled for Linux."
#endif

#if AURORE_NETWORK_BACKEND_KQUEUE && !AURORE_PLATFORM_MACOS
#error "The current Aurore kqueue contract is reserved for macOS."
#endif

#if !AURORE_HAS_PLATFORM_NETWORK_BACKEND \
	&& !AURORE_ALLOW_MISSING_PLATFORM_BACKEND

#error \
	"No Aurore network backend exists for this platform. " \
	"Missing-backend builds are allowed only for explicit porting builds."

#endif

namespace Aurore::Build {
	inline constexpr bool IsWindows{
		AURORE_PLATFORM_WINDOWS != 0
	};

	inline constexpr bool IsLinux{
		AURORE_PLATFORM_LINUX != 0
	};

	inline constexpr bool IsMacOS{
		AURORE_PLATFORM_MACOS != 0
	};

	inline constexpr bool HasPlatformNetworkBackend{
		AURORE_HAS_PLATFORM_NETWORK_BACKEND != 0
	};
}
