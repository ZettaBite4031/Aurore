{
  "version": 4,
  "configurations": [
    {
      "name": "Aurore - Windows MSVC",
      "compilerPath": "cl.exe",
      "cStandard": "c17",
      "cppStandard": "c++23",
      "intelliSenseMode": "windows-msvc-x64",
      "compileCommands": "${workspaceFolder}/out/build/windows-debug/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/Aurore.Server/**",
        "${workspaceFolder}/Aurore.Tests/**",
        "${workspaceFolder}/include/**",
        "${workspaceFolder}/src/**"
      ],
      "defines": [
        "_WIN32",
        "_WIN64",
        "NOMINMAX"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}",
          "${workspaceFolder}/Aurore.Server",
          "${workspaceFolder}/Aurore.Tests",
          "${workspaceFolder}/include",
          "${workspaceFolder}/src"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    },
    {
      "name": "Aurore - Windows Clang",
      "compilerPath": "clang-cl.exe",
      "cStandard": "c17",
      "cppStandard": "c++23",
      "intelliSenseMode": "windows-clang-x64",
      "compileCommands": "${workspaceFolder}/out/build/windows-debug/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "defines": [
        "_WIN32",
        "_WIN64",
        "NOMINMAX"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    },
    {
      "name": "Aurore - Linux GCC",
      "compilerPath": "/usr/bin/g++",
      "cStandard": "c17",
      "cppStandard": "c++23",
      "intelliSenseMode": "linux-gcc-x64",
      "compileCommands": "${workspaceFolder}/out/build/linux-debug/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/Aurore.Server/**",
        "${workspaceFolder}/Aurore.Tests/**",
        "${workspaceFolder}/include/**",
        "${workspaceFolder}/src/**"
      ],
      "defines": [
        "__linux__"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}",
          "${workspaceFolder}/Aurore.Server",
          "${workspaceFolder}/Aurore.Tests",
          "${workspaceFolder}/include",
          "${workspaceFolder}/src"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    },
    {
      "name": "Aurore - Linux Clang",
      "compilerPath": "/usr/bin/clang++",
      "cStandard": "c17",
      "cppStandard": "c++23",
      "intelliSenseMode": "linux-clang-x64",
      "compileCommands": "${workspaceFolder}/out/build/linux-debug/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "defines": [
        "__linux__"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
